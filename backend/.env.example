# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (MySQL / Cloud Database)
# Example for local MySQL: mysql+pymysql://root:2124@localhost/hr_policy_db
# Example for Cloud MySQL (Aiven/Railway/TiDB): mysql+pymysql://username:password@host:port/database
DATABASE_URL=mysql+pymysql://root:2124@localhost/hr_policy_db

# Allowed CORS Origins (Comma-separated for live frontend domains)
# Example: https://my-hr-frontend.vercel.app,https://my-hr-frontend.netlify.app
ALLOWED_ORIGINS=
